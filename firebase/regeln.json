{
  "rules": {
    ".read": false,
    ".write": false,

    "bali-wasser": {
      "oeffentlich": {
        ".read": true,
        "$sitzung": {
          "$runde": {
            "$geraet": {
              ".write": "newData.exists()",
              ".validate": "$sitzung.matches(/^[a-z0-9-]{2,24}$/) && ($runde === 'vorher' || $runde === 'nachher') && $geraet.matches(/^[a-z0-9]{12,40}$/) && newData.hasChildren(['w', 't'])",
              "w": { ".validate": "newData.isString() && newData.val().matches(/^(ja|bed|nein)$/)" },
              "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
              "$anderes": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
